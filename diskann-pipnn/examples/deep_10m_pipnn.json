{
  "search_directories": ["datasets/yandex_deep"],
  "jobs": [
    {
      "type": "disk-index",
      "content": {
        "source": {
          "disk-index-source": "Build",
          "data_type": "float32",
          "data": "deep_10m.fbin",
          "distance": "squared_l2",
          "dim": 96,
          "max_degree": 64,
          "l_build": 64,
          "num_threads": 16,
          "build_ram_limit_gb": 32.0,
          "num_pq_chunks": 48,
          "quantization_type": "FP",
          "build_algorithm": {
            "algorithm": "PiPNN",
            "c_max": 256,
            "c_min": 16,
            "p_samp": 0.05,
            "fanout": [10, 3],
            "leaf_k": 3,
            "replicas": 1,
            "l_max": 64,
            "num_hash_planes": 12,
            "final_prune": false
          },
          "save_path": "target/tmp/deep_10m_pipnn_index"
        },
        "search_phase": {
          "queries": "deep_query_10k.fbin",
          "groundtruth": "deep_gt_10m.bin",
          "num_threads": 16,
          "beam_width": 4,
          "search_list": [50, 100],
          "recall_at": 10,
          "is_flat_search": false,
          "distance": "squared_l2"
        }
      }
    }
  ]
}
